---
// Frame of every locale page: head rules (docs/contracts/routing-locale.md section 4), skip link, header with the
// language selector, the <main id="content"> that pages fill, and the footer. A page only supplies its content.
import '../styles/global.css';
import FontPreload from '../components/FontPreload.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { t } from '../i18n/index.ts';
import type { MessageKey } from '../i18n/index.ts';
import { alternates, HTML_LANG, LOCALES, OG_LOCALE, routePath, xDefaultPath } from '../lib/routes.ts';
import type { Locale, RouteKey } from '../lib/routes.ts';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
}

const { locale, routeKey } = Astro.props;
const origin = Astro.site;
if (origin === undefined) throw new Error('`site` must be set in astro.config.ts');

const absolute = (path: string): string => new URL(path, origin).href;
const title = t(locale, `meta.${routeKey}.title` as MessageKey);
const description = t(locale, `meta.${routeKey}.description` as MessageKey);
const otherLocales = LOCALES.filter((other) => other !== locale);
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absolute(routePath(locale, routeKey))} />
    {
      alternates(routeKey).map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={absolute(alternate.path)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={absolute(xDefaultPath(routeKey))} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(routePath(locale, routeKey))} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {otherLocales.map((other) => <meta property="og:locale:alternate" content={OG_LOCALE[other]} />)}
    <FontPreload />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#content"
      class="absolute top-8 left-8 z-10 -translate-y-[200%] rounded-botao bg-papel px-16 py-12 text-nav text-violeta-ata focus:translate-y-0"
    >
      {t(locale, 'nav.skip')}
    </a>
    <SiteHeader locale={locale} routeKey={routeKey} />
    <main id="content" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
