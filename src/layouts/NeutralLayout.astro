---
// Frame of the pages that belong to no locale: the root chooser, the 404 and the /discord page
// (docs/contracts/routing-locale.md sections 1 and 3). The page language is en-US (the x-default language, so WCAG 3.1.1
// is met) and every element in the other language carries its own `lang`. There is no locale header, selector or
// footer here, and no script; the logo links to the root (the chooser, which Cloudflare redirects to a locale); the skip link is in English, the page language. Extra head tags (for example the x-default alternate) go in the `head` slot; a page head band (the 404) goes in the `band` slot.
import '../styles/global.css';
import BrandHead from '../components/BrandHead.astro';
import FontPreload from '../components/FontPreload.astro';
import SkipLink from '../components/SkipLink.astro';
import Wordmark from '../components/Wordmark.astro';
import { t } from '../i18n/index.ts';

interface Props {
  title: string;
  /** Optional description (en-US, the page language). */
  description?: string;
  /** 404 and /discord are not indexable. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {description !== undefined && <meta name="description" content={description} />}
    <slot name="head" />
    <BrandHead />
    <FontPreload />
  </head>
  <body class="flex min-h-screen flex-col">
    <SkipLink locale="en-us" />
    <header class="border-b border-pauta bg-violeta-ata">
      <div class="frame flex h-[56px] items-center">
        <a
          href="/"
          aria-label={t('en-us', 'a11y.logo')}
          aria-current={Astro.url.pathname === '/' ? 'page' : undefined}
          class="inline-flex min-h-[44px] items-center"
        >
          <Wordmark />
        </a>
      </div>
    </header>
    <main id="content" tabindex="-1" class="flex-1">
      <slot name="band" />
      <div class="frame section-y">
        <slot />
      </div>
    </main>
  </body>
</html>
