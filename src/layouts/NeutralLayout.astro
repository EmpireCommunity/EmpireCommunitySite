---
// Frame of the pages that belong to no locale: the root chooser, the 404 and the /discord page
// (docs/contracts/routing-locale.md sections 1 and 3). The page language is en-US (the x-default language, so WCAG 3.1.1
// is met) and every element in the other language carries its own `lang`. There is no locale header, selector or
// footer here, and no script; the skip link is in English, the page language. Extra head tags (for example the x-default alternate) go in the `head` slot.
import '../styles/global.css';
import FontPreload from '../components/FontPreload.astro';
import SkipLink from '../components/SkipLink.astro';
import Wordmark from '../components/Wordmark.astro';

interface Props {
  title: string;
  /** 404 and /discord are not indexable. */
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <slot name="head" />
    <FontPreload />
  </head>
  <body class="flex min-h-screen flex-col">
    <SkipLink locale="en-us" />
    <header class="bg-violeta-ata">
      <div class="frame flex h-[56px] items-center lg:h-[72px]">
        <Wordmark />
      </div>
    </header>
    <main id="content" tabindex="-1" class="flex-1">
      <div class="frame section-y">
        <slot />
      </div>
    </main>
  </body>
</html>
