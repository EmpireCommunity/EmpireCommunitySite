---
// Neutral bilingual page served with status 404 for any unknown path (routing-locale section 1).
import '../styles/global.css';
import { routePath } from '../lib/routes.ts';
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Página não encontrada · Page not found</title>
  </head>
  <body>
    <main id="content">
      <section lang="pt-BR">
        <h1>Página não encontrada</h1>
        <p>Este endereço não existe ou mudou de lugar.</p>
        <p><a href={routePath('pt-br', 'home')}>Ir para o início</a></p>
      </section>
      <section lang="en-US">
        <h1>Page not found</h1>
        <p>This address does not exist or has moved.</p>
        <p><a href={routePath('en-us', 'home')}>Go to the home page</a></p>
      </section>
    </main>
  </body>
</html>
