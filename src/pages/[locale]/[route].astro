---
// One page per inner route key and locale: the keys without a page file of their own, x 2 locales. Slugs come from src/lib/routes.ts.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/index.ts';
import type { MessageKey } from '../../i18n/index.ts';
import { INNER_ROUTE_KEYS, LOCALES, isLocale, routeKeyFromSlug, slugOf } from '../../lib/routes.ts';

// getStaticPaths is hoisted by Astro, so the list of route keys that have their own page file
// (src/pages/[locale]/<slug>.astro) lives inside it. Add a key to `ownPage` when its page task lands.
export const getStaticPaths = (() => {
  const ownPage: readonly string[] = ['join', 'projects', 'game-servers', 'organization', 'support', 'terms', 'privacy'];
  return LOCALES.flatMap((locale) =>
    INNER_ROUTE_KEYS.filter((routeKey) => !ownPage.includes(routeKey)).map((routeKey) => ({
      params: { locale, route: slugOf(routeKey) },
    })),
  );
}) satisfies GetStaticPaths;

const { locale, route } = Astro.params;
const routeKey = route === undefined ? undefined : routeKeyFromSlug(route);
if (!isLocale(locale) || routeKey === undefined) throw new Error(`unexpected route: ${locale}/${route}`);
---

<BaseLayout locale={locale} routeKey={routeKey}>
  <div class="frame section-y">
    <h1 class="font-display text-display text-papel">{t(locale, `meta.${routeKey}.title` as MessageKey)}</h1>
  </div>
</BaseLayout>
