---
// Origin fallback of the public address /discord (docs/contracts/routing-locale.md "`/discord` and the gate pages",
// D-78): Cloudflare answers /discord with a 302 to the gate page of the visitor's language; this static chooser is what
// the origin serves, with HTTP 200, when the rules are off or on direct origin access, so an old link never breaks.
// Same markup rules as the root chooser: page language en-US, each link marked with its own `lang`, no script, no
// hreflang alternates, no canonical (it is not a page of a language pair), noindex. No invite, no WhatsApp reference
// and no rules text here: those exist only on the gate pages.
import NeutralLayout from '../layouts/NeutralLayout.astro';
import { routePath } from '../lib/routes.ts';

const linkClass = 'link-text flex min-h-[44px] items-center py-16 font-display text-title';
---

<NeutralLayout title="EmpireCommunity" noindex>
  <h1 class="font-display text-page-title text-papel">EmpireCommunity</h1>
  <ul class="mt-32 border-b border-pauta">
    <li class="border-t border-pauta">
      <a href={routePath('pt-br', 'discord')} lang="pt-BR" hreflang="pt-BR" class={linkClass}>Português (Brasil)</a>
    </li>
    <li class="border-t border-pauta">
      <a href={routePath('en-us', 'discord')} lang="en-US" hreflang="en-US" class={linkClass}>English</a>
    </li>
  </ul>
</NeutralLayout>
