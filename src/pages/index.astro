---
// Fallback chooser: shown only when the Cloudflare redirect rules are off or on direct origin access
// (docs/contracts/routing-locale.md section 3). Static, HTTP 200, no script. The page language is en-US and the
// Portuguese link is marked with its own `lang`.
import NeutralLayout from '../layouts/NeutralLayout.astro';
import { routePath } from '../lib/routes.ts';

const site = Astro.site;
if (site === undefined) throw new Error('`site` must be set in astro.config.ts');
---

<NeutralLayout title="EmpireCommunity">
  <link slot="head" rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
  <h1 class="font-display text-display text-papel">EmpireCommunity</h1>
  <ul class="mt-48 border-b border-pauta">
    <li class="border-t border-pauta">
      <a
        href={routePath('pt-br', 'home')}
        lang="pt-BR"
        hreflang="pt-BR"
        class="link-text flex min-h-[44px] items-center py-24 font-display text-title"
      >
        Português (Brasil)
      </a>
    </li>
    <li class="border-t border-pauta">
      <a
        href={routePath('en-us', 'home')}
        lang="en-US"
        hreflang="en-US"
        class="link-text flex min-h-[44px] items-center py-24 font-display text-title"
      >
        English
      </a>
    </li>
  </ul>
</NeutralLayout>
