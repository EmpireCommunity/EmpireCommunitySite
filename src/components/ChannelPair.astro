---
// The channels of a locale as equal buttons: pt-BR Discord then WhatsApp (stacked below 640 px, side by side from
// 640 px, 240 px each), en-US a single Discord button. Every button goes to the gate page of its own locale (D-41, D-78).
import { t } from '../i18n/index.ts';
import { getJoinChannels } from '../lib/site-data.ts';
import { routePath } from '../lib/routes.ts';
import type { Locale } from '../lib/routes.ts';
import ChannelButton from './ChannelButton.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const channels = await getJoinChannels(locale);
const ICON = { discord: 'discord', whatsapp: 'whatsapp' } as const;
---

<div class="grid w-full gap-16 sm:w-auto sm:grid-flow-col sm:auto-cols-[240px]">
  {
    channels.map((channel) => (
      <ChannelButton
        href={routePath(locale, 'discord')}
        label={t(locale, 'cta.join', { channel: channel.label })}
        icon={channel.id === 'whatsapp' ? ICON.whatsapp : ICON.discord}
      />
    ))
  }
</div>
