---
// One question of the FAQ (DESIGN.md "Perguntas frequentes"): native <details>, so it works without JavaScript.
// Pauta rule above, plus sign in pauta-forte on the right that turns 45° when open (120 ms, off with reduced motion),
// the summary is underlined on hover, the answer is Body in papel-suave, at most 68 characters wide.
import Icon from './Icon.astro';

interface Props {
  question: string;
}

const { question } = Astro.props;
---

<li class="border-t border-pauta">
  <details class="group">
    <summary
      class="flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-16 py-12 text-title hover:underline [&::-webkit-details-marker]:hidden"
    >
      <span class="font-display">{question}</span>
      <Icon name="plus" class="shrink-0 text-pauta-forte group-open:rotate-45 motion-safe:transition-transform" />
    </summary>
    <div class="max-w-[72ch] pb-24 text-body text-papel-suave">
      <slot />
    </div>
  </details>
</li>
