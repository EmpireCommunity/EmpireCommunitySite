---
// Footer of every locale page: four groups (information-architecture section 4), `violeta-noite`, the page "descends a tone".
// Community lists the channels of the locale from join-channels.yaml (WhatsApp only in pt-BR, C-1) with the same
// weight. Every channel link goes to the gate page of the locale (D-41, D-78).
import { t } from '../i18n/index.ts';
import { LEGAL_ITEMS, NAV_ITEMS } from '../lib/navigation.ts';
import { routePath } from '../lib/routes.ts';
import { getJoinChannels, getSite } from '../lib/site-data.ts';
import Wordmark from './Wordmark.astro';
import type { Locale } from '../lib/routes.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const [{ contact, links }, channels] = await Promise.all([getSite(), getJoinChannels(locale)]);

const linkClass =
  'link-text inline-flex min-h-[44px] min-w-[44px] items-center text-body-sm [overflow-wrap:anywhere] text-papel-suave hover:text-papel motion-safe:transition-colors';
const headingClass = 'text-body-sm font-medium text-papel';
---

<footer class="bg-violeta-noite pt-48 text-papel-suave">
  <div class="frame">
    <div class="grid gap-x-24 gap-y-32 lg:grid-cols-12">
      <a
        href={routePath(locale, 'home')}
        aria-label={t(locale, 'a11y.logo')}
        class="inline-flex min-h-[44px] items-center self-start lg:col-span-4"
      >
        <Wordmark />
      </a>
      <div class="grid grid-cols-2 gap-x-24 gap-y-32 lg:col-span-8 lg:grid-cols-4">
      <section>
        <h2 class={headingClass}>{t(locale, 'footer.site')}</h2>
        <ul class="mt-8">
          {
            NAV_ITEMS.map((item) => (
              <li>
                <a href={routePath(locale, item.key)} class={linkClass}>
                  {t(locale, item.label)}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2 class={headingClass}>{t(locale, 'footer.community')}</h2>
        <ul class="mt-8">
          {
            channels.map((channel) => (
              <li>
                <a href={routePath(locale, 'discord')} class={linkClass}>
                  {channel.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={links.github} class={linkClass}>{t(locale, 'footer.github')}</a>
          </li>
        </ul>
      </section>

      <section>
        <h2 class={headingClass}>{t(locale, 'footer.contact')}</h2>
        <ul class="mt-8">
          <li>
            <a href={`mailto:${contact.general}`} class={linkClass}>{contact.general}</a>
          </li>
          <li>
            <a href={`mailto:${contact.legal}`} class={linkClass}>{contact.legal}</a>
          </li>
        </ul>
      </section>

      <section>
        <h2 class={headingClass}>{t(locale, 'footer.legal')}</h2>
        <ul class="mt-8">
          {
            LEGAL_ITEMS.map((item) => (
              <li>
                <a href={routePath(locale, item.key)} class={linkClass}>
                  {t(locale, item.label)}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      </div>
    </div>

    <p class="mt-32 flex min-h-[56px] items-center justify-center border-t border-pauta text-center text-label text-papel-apagado [overflow-wrap:anywhere]">
      {t(locale, 'footer.line')}
    </p>
  </div>
</footer>
