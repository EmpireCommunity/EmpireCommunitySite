---
// Skip link (DESIGN.md "Pular para o conteúdo"): off screen until it receives focus, then the first thing on the page.
// The target is the <main id="content"> of the layout. Shared by BaseLayout and NeutralLayout. The wrapper is a `frame`,
// so the focused link starts on the page margin (16 / 32 / 64 px, centered like the rest) and ignores the pointer.
import { t } from '../i18n/index.ts';
import type { Locale } from '../lib/routes.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="frame pointer-events-none absolute inset-x-0 top-8 z-10">
  <a
    href="#content"
    class="pointer-events-auto inline-block -translate-y-[200%] rounded-botao bg-papel px-16 py-12 text-nav text-violeta-ata focus:translate-y-0"
  >
    {t(locale, 'nav.skip')}
  </a>
</div>
