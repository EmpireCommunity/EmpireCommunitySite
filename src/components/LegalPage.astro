---
// Legal reading page (information-architecture sections 7.7 and 7.8): page head band (title, version, the effective date only when the
// file has one, no placeholder date, D-51), the table of contents with anchors and the text in one column of up to 72
// characters, with A Margem (1 px, `margem`) at the start of the text column from 1024 px. On desktop the contents sit in the left three columns and stay in view (the contents scrolls inside the viewport height, so no link is out of reach); below 1024 px the
// contents is a list above the text. The text is the rendered Markdown (no raw HTML, explicit heading ids).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from './PageHead.astro';
import { t } from '../i18n/index.ts';
import { getLegal } from '../lib/legal.ts';
import type { LegalKey } from '../lib/legal.ts';
import { formatRulesDate } from '../lib/community-rules.ts';
import type { Locale } from '../lib/routes.ts';

interface Props {
  locale: Locale;
  routeKey: LegalKey;
}

const { locale, routeKey } = Astro.props;
const legal = await getLegal(locale, routeKey);
---

<BaseLayout locale={locale} routeKey={routeKey}>
  <PageHead title={legal.title}>
    <p>{t(locale, 'legal.version', { version: legal.version })}</p>
    {
      legal.effectiveDate !== undefined && (
        <p class="mt-4">{t(locale, 'legal.effective', { date: formatRulesDate(legal.effectiveDate, locale) })}</p>
      )
    }
  </PageHead>
  <div class="frame pt-24 pb-40 lg:pt-32 lg:pb-64">
    <div class="grid gap-x-24 gap-y-24 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <div class="lg:sticky lg:top-24 lg:-m-4 lg:max-h-[calc(100dvh-var(--spacing-96))] lg:overflow-y-auto lg:p-4">
          <nav aria-label={t(locale, 'legal.toc')}>
            <p class="text-label text-papel-suave">{t(locale, 'legal.toc')}</p>
            <ul class="mt-8 flex flex-col">
              {
                legal.clauses.map((clause) => (
                  <li>
                    <a href={`#${clause.id}`} class="link-text inline-flex min-h-[44px] items-center text-body-sm text-papel-suave hover:text-papel motion-safe:transition-colors">{clause.text}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
      <article class="legal-text lg:col-span-9 lg:border-l lg:border-margem lg:pl-24">
        <legal.Content />
      </article>
    </div>
  </div>
</BaseLayout>
