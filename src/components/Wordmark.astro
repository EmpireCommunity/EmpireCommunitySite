---
// LOGO SWAP POINT (the only one): the approved Rack lockup (D-40, D-42), `src/assets/brand/lockup-header.svg`, 242 x 28.
// It is inlined, so the bars and the word take the text colour (`currentColor`, papel here) and the two LEDs keep their
// fixed colours; an <img> could not inherit the colour. There is no inline style or script: size comes from classes.
// Height 28 px, 22 px below 376 px (`max-[376px]`: Tailwind 4 `max-*` is a strict "less than") (the lockup's minimum height), which also keeps it clear of the Menu button at 320 px.
// The name is on the SVG (`role="img"`), so it is announced alone on the neutral pages; inside the header link the
// link's own `aria-label` (`a11y.logo`) takes over, as before.
import lockup from '../assets/brand/lockup-header.svg?raw';

interface Props {
  /** Accessible name of the mark (the brand name is not translated). */
  label?: string;
}

const { label = 'EmpireCommunity' } = Astro.props;
const svg = lockup.replace(
  /<svg\b[^>]*>/,
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 242 28" role="img" aria-label="${label}" focusable="false" class="block h-[28px] w-auto shrink-0 text-papel max-[376px]:h-[22px]">`,
);
---

<Fragment set:html={svg} />
